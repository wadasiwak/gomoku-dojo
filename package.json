{
  "name": "gomoku-dojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-openings.mjs && node scripts/check-puzzles.mjs && node scripts/check-opening-book.mjs",
    "check:openings": "node scripts/check-openings.mjs",
    "check:book": "node scripts/check-opening-book.mjs",
    "gen:book": "node scripts/gen-opening-book.mjs",
    "gen:puzzles": "node scripts/gen-puzzles.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
